{
	"model": {
		"type": "minecraft:select",
		"property": "minecraft:display_context",
		"cases": [
			{
				"when": [ "gui", "ground", "fixed", "on_shelf" ],
				"model": { "type": "minecraft:model", "model": "sephiria_fantasy:item/default_sword_and_shield" }
			},
			{
				"when": [ "firstperson_lefthand", "thirdperson_lefthand" ],
				"model": { "type": "minecraft:model", "model": "sephiria_fantasy:item/shield_in_hand" }
			}
		],
		"fallback": { "type": "minecraft:model", "model": "sephiria_fantasy:item/sword_in_hand" }
	}
}