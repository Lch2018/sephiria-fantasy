{
	"schemaVersion": 1,
	"id": "sephiria_fantasy",
	"version": "${version}",
	"name": "赛菲莉娅幻想",
	"description": "把《SEPHIRIA（赛菲莉娅）》的武器系统带进 Minecraft。非官方同人模组，大量使用 AI 生成代码，仅供学习交流，禁止商业行为；完整条款见仓库 LICENSE。",
	"authors": [
		"Lch2018"
	],
	"contact": {
		"homepage": "https://github.com/Lch2018/sephiria-fantasy",
		"sources": "https://github.com/Lch2018/sephiria-fantasy",
		"issues": "https://github.com/Lch2018/sephiria-fantasy/issues"
	},
	"license": "CC-BY-NC-4.0",
	"icon": "assets/sephiria_fantasy/icon.png",
	"environment": "*",
	"accessWidener": "sephiria_fantasy.accesswidener",
	"entrypoints": {
		"main": [
			"com.sephiria.Sephiria"
		],
		"client": [
			"com.sephiria.client.SephiriaClient"
		],
		"modmenu": [
			"com.sephiria.compat.modmenu.SephiriaModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"mixins": [
		"sephiria_fantasy.mixins.json",
		{
			"config": "sephiria_fantasy.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "sephiria_fantasy.torohealth.mixins.json",
			"environment": "client"
		}
	],
	"suggests": {
		"torohealth": "*",
		"modmenu": "*"
	}
}
